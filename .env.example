# ============================================================================
# SWAGGYMUSIC GitHub Controller Bot - Environment Configuration Example
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. All values below are EMPTY PLACEHOLDERS.
# Generate strong secrets with: openssl rand -hex 32
# ============================================================================

# --- Telegram ---
# Bot token issued by @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs that own this bot instance.
# Owners can use server-level GitHub credentials and reload admin caches.
BOT_OWNER_IDS=

# --- Database ---
# MongoDB connection string. Use the service name `mongo` when running via
# docker-compose. NEVER expose MongoDB publicly in production.
#
# When using the docker-compose file (which provisions mongo with auth):
#   MONGODB_URI=mongodb://<MONGO_USER>:<MONGO_PASSWORD>@mongo:27017
#
# When running standalone:
#   MONGODB_URI=mongodb://localhost:27017
MONGODB_URI=
MONGODB_DATABASE=swaggymusic_github_bot

# Credentials used by docker-compose to initialise MongoDB (only on first run).
# Choose a strong password and use the same value in MONGODB_URI above.
MONGO_USER=
MONGO_PASSWORD=

# --- GitHub (Server-level / Owner) ---
# Default GitHub API URL. Use https://api.github.com for github.com.
# For GitHub Enterprise Server, set to https://YOUR-HOST/api/v3.
GITHUB_API_URL=https://api.github.com

# OPTIONAL: Server-level Personal Access Token used ONLY for explicitly
# configured owner/system operations. NEVER exposed to normal Telegram users.
GITHUB_TOKEN=

# OPTIONAL: Default repository used by server-level operations.
# Example: https://github.com/OWNER/REPOSITORY
GITHUB_REPO_URL=

# Allowlist of GitHub Enterprise hosts (comma separated). When non-empty,
# users cannot configure arbitrary custom GITHUB_API_URL values.
GITHUB_ENTERPRISE_ALLOWLIST=

# --- GitHub OAuth App ---
# Configure at: https://github.com/settings/developers
# Authorization callback URL must be: https://YOUR-DOMAIN/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=

# --- Webhooks ---
# Shared secret used to validate incoming GitHub webhook payloads.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# --- Security ---
# 32-byte (64 hex characters) AES-256-GCM key used to encrypt stored tokens.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Random secret used to sign session cookies / state tokens.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Server ---
PORT=8080
# Public base URL of the bot server (no trailing slash).
# Must be HTTPS in production for GitHub OAuth and webhooks.
PUBLIC_BASE_URL=

# --- Logging ---
# One of: debug, info, warn, error
LOG_LEVEL=info

# --- Rate Limiting ---
# Max Telegram commands per user per minute.
RATE_LIMIT_COMMANDS_PER_MIN=20
# Max GitHub API calls per user per minute (defensive; GitHub also enforces).
RATE_LIMIT_GITHUB_PER_MIN=60
